# You.com API key (https://you.com/platform). Required. Powers Search, Contents, Answer, Research
# and, by default, the LLM steps via the You.com Inference Router.
YDC_API_KEY=
# Optional: model for the Inference Router (see GET https://api.you.com/v1/models)
YDC_LLM_MODEL=kimi-k3
# Optional fallback LLM if the router fails
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: "Check my inbox" reads unread mail from a dedicated Gmail over IMAP.
# Turn on 2-Step Verification, then create an app password at https://myaccount.google.com/apppasswords
IMAP_USER=
IMAP_APP_PASSWORD=
