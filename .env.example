# You.com API key (https://you.com/platform). Required. Powers Search, Contents, Answer, Research.
YDC_API_KEY=
# LLM steps use Anthropic by default.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: set to 1 to try the You.com Inference Router first (Anthropic stays as fallback)
YDC_LLM_ROUTER=
YDC_LLM_MODEL=kimi-k3
# Optional: "Check my inbox" reads unread mail from a dedicated Gmail over IMAP.
# Turn on 2-Step Verification, then create an app password at https://myaccount.google.com/apppasswords
IMAP_USER=
IMAP_APP_PASSWORD=
# The same app password is used for SMTP (smtp.gmail.com:465) to file the report back into the Gmail thread.
# Gmail add-on: shared secret the add-on sends as x-brandcheck-token to /api/addon
ADDON_TOKEN=
